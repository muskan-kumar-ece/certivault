# ==============================================================================
# CertiVault Environment Variables Specification (TRD.md §17)
# ==============================================================================

# Supabase (Public - Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Server Only - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application & Verification URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
VERIFY_BASE_URL=http://localhost:3000

# Worker Endpoint Secret (Bearer token for cron and internal kicks)
WORKER_SECRET=replace_with_a_secure_random_string_32_chars_or_more

# Email Delivery (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="CertiVault <certificates@certivault.venopai.in>"

# Payments & Billing (Razorpay - INR)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Rate Limiting & Edge Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Observability (Sentry & PostHog)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Optional AI Features (Default: false per TRD §12 & ADR 10)
AI_ENABLED=false
ANTHROPIC_API_KEY=
